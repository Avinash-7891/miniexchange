# ============================================================
#  Copy this file to `.env` and fill in your own values:
#      cp .env.example .env        (macOS / Linux / Git Bash)
#      copy .env.example .env      (Windows CMD)
#
#  `.env` is git-ignored and must NEVER be committed.
#  This `.env.example` is committed so everyone knows which
#  variables the project expects.
# ============================================================

# Port the backend server listens on
PORT=5000

# MongoDB connection string.
# If this is unreachable the app automatically boots an in-memory
# MongoDB (mongodb-memory-server) instead, so it runs with zero setup.
# For the docker-compose setup, this default is exactly right.
MONGODB_URI=mongodb://localhost:27017/miniexchange

# Set to 'true' to force the in-memory database (skip MONGODB_URI
# entirely). Handy for running the test suite.
USE_MEMORY_DB=false

# Secret used to sign JWT session tokens.
# CHANGE THIS to a long random string before deploying anywhere public:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# `development` shows error stack traces; `production` hides them.
NODE_ENV=development
